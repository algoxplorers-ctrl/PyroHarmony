@echo off
setlocal EnableDelayedExpansion
title PyroHarmony - Sincronizar con GitHub (Equipo AlgoXplorers)
color 0B
cd /d "%~dp0"

set "GIT_CMD=git"
where git >nul 2>nul
if %ERRORLEVEL% EQU 0 goto MENU
if exist "C:\Program Files\Git\cmd\git.exe" set "GIT_CMD=C:\Program Files\Git\cmd\git.exe" & goto MENU
color 0C
echo [ERROR] No se encontro Git instalado en el sistema.
pause
exit /b 1

:MENU
cls
echo ===============================================================================
echo   PYROHARMONY v2.0.0 - TRABAJO EN EQUIPO CON GITHUB (@cvizzioli)
echo   Repositorio: https://github.com/algoxplorers-ctrl/PyroHarmony
echo ===============================================================================
echo.
echo   [1] TRAER cambios de mi companero (git pull)
echo   [2] GUARDAR Y SUBIR mis cambios a GitHub (build + commit + pull + push)
echo   [3] VER que archivos modifique y ultimos commits (git status / log)
echo   [4] Salir
echo.
set "OPCION="
set /p "OPCION=Selecciona una opcion (1-4) [Por defecto 2]: "
if "%OPCION%"=="" set "OPCION=2"

if "%OPCION%"=="1" goto PULL
if "%OPCION%"=="2" goto PUSH
if "%OPCION%"=="3" goto STATUS
if "%OPCION%"=="4" exit /b 0
goto MENU

:PULL
echo.
echo [1/1] Descargando ultimos cambios desde GitHub (origin/main)...
"%GIT_CMD%" pull --rebase origin main
echo.
if %ERRORLEVEL% EQU 0 echo [OK] Tu carpeta local esta actualizada con los ultimos cambios del equipo.
if %ERRORLEVEL% NEQ 0 echo [ATENCION] Hubo un conflicto o error al traer cambios. Revisa el mensaje arriba.
echo.
pause
goto MENU

:PUSH
echo.
echo [1/4] Verificando si hay cambios en src/ para actualizar app.bundle.js...
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
echo Estado actual de archivos modificados:
"%GIT_CMD%" status -s
echo.
set "MSG="
set /p "MSG=Escribe una breve descripcion de tu cambio (Enter = Actualizacion @cvizzioli): "
if "%MSG%"=="" set "MSG=Actualizacion @cvizzioli"

echo.
echo [2/4] Preparando y guardando cambios locales (git add + commit)...
"%GIT_CMD%" add -A
"%GIT_CMD%" commit -m "%MSG%"

echo.
echo [3/4] Sincronizando con cambios previos del equipo (git pull --rebase)...
"%GIT_CMD%" pull --rebase origin main
if %ERRORLEVEL% NEQ 0 goto PUSH_CONFLICT

echo.
echo [4/4] Subiendo cambios a GitHub (git push origin main)...
"%GIT_CMD%" push origin main
if %ERRORLEVEL% EQU 0 echo [EXITO] Tus cambios ya estan publicados en GitHub para todo el equipo.
if %ERRORLEVEL% NEQ 0 echo [ERROR] No se pudo subir a GitHub. Verifica tu sesion o permisos en el navegador.
echo.
pause
goto MENU

:PUSH_CONFLICT
echo [ERROR] Conflicto detectado con cambios de tu companero. Resuelvelo antes de subir.
pause
goto MENU

:STATUS
echo.
echo --- ARCHIVOS MODIFICADOS LOCALMENTE ---
"%GIT_CMD%" status
echo.
echo --- ULTIMOS 5 CAMBIOS EN EL REPOSITORIO ---
"%GIT_CMD%" log -n 5 --oneline --decorate
echo.
pause
goto MENU
