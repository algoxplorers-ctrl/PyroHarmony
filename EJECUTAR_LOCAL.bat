@echo off
title PyroHarmony v2.0.0 - Ejecucion Local (@cvizzioli)
color 0B
cd /d "%~dp0"
echo ===============================================================================
echo   PYROHARMONY v2.0.0 - EJECUCION LOCAL DE DESARROLLO (@cvizzioli)
echo   Compila tus cambios de src/ en app.bundle.js y abre el navegador
echo ===============================================================================
echo.
echo [1/2] Verificando cambios en modulos MVC (src/)...
where node >nul 2>nul
if %ERRORLEVEL% EQU 0 goto BUILD_NODE
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
goto OPEN_APP
:BUILD_NODE
node build_bundle.mjs
:OPEN_APP
echo.
echo [2/2] Abriendo PyroHarmony (index.html) en tu navegador predeterminado...
start "" "%~dp0index.html"
echo.
echo Listo. La pagina se abrio en el navegador.
exit /b 0
